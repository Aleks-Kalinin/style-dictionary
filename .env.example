DATABASE_URL="file:./dev.db"

# --- Sentry -------------------------------------------------------------
# Leave blank and the app runs normally with Sentry inert (no network calls).
# Fill it in to start seeing events: Sentry > Settings > Projects > Client Keys.
NEXT_PUBLIC_SENTRY_DSN=""

# Only needed to upload source maps during `npm run build`.
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"
# SENTRY_AUTH_TOKEN="sntrys_..."
