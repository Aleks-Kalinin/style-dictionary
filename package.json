{
  "name": "graphql-react",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "schema:print": "tsx --tsconfig tsconfig.json scripts/print-schema.ts",
    "postinstall": "prisma generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:a11y": "vitest run",
    "test:a11y:light": "vitest run --project=storybook-light",
    "test:a11y:dark": "vitest run --project=storybook-dark",
    "tokens:build": "node scripts/build-tokens.mjs",
    "prebuild": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "@apollo/client": "^4.3.7",
    "@pothos/core": "^4.16.0",
    "@pothos/plugin-prisma": "^4.17.0",
    "@pothos/plugin-simple-objects": "^4.1.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.11.0",
    "better-sqlite3": "^13.0.3",
    "graphql": "^17.1.0",
    "graphql-scalars": "^2.0.1",
    "graphql-yoga": "^6.0.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/nextjs-vite": "^10.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright": "^1.57.0",
    "prisma": "^7.10.1",
    "storybook": "^10.6.6",
    "style-dictionary": "^5.8.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
